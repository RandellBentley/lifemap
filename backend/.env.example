# Copy to .env for running Django outside docker compose. All settings: config/settings.py
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# local = sign in via /api/admin (dev); cognito = OIDC via Cognito managed login
AUTH_MODE=local
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_DOMAIN=https://<prefix>.auth.us-east-1.amazoncognito.com

# Omit DATABASE_HOST to use SQLite
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=lifemap
DATABASE_USER=lifemap
DATABASE_PASSWORD=lifemap

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
MEDIA_BUCKET=lifemap-media-local
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
MEDIA_PROCESSING_ENABLED=0

# Production only (set by Terraform):
# CLOUDFRONT_MEDIA_BASE_URL=https://app.example.com
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY=
# INTERNAL_API_TOKEN=

# Feature flags (comma-separated), e.g. workouts. Unknown names stop the server at startup.
FEATURES=workouts
