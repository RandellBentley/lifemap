# Settings for scripts/local-prod.sh: the production host stack, run locally.
# Dummy secrets only. Used both for compose interpolation and as the app's env_file.

# --- Compose overrides (paths are relative to infra/host/) ---
APP_IMAGE=lifemap-backend:local
APP_ENV_FILE=../local/local.env
PGDATA_DIR=../local/.data/postgres
CLOUDFRONT_KEY_FILE=../local/.secrets/cloudfront_key.pem
ORIGIN_PORT=8443
CADDY_TLS=tls_internal

# --- Origin Caddy ---
ORIGIN_DOMAIN=origin
ORIGIN_VERIFY_SECRET=local-origin-secret
ACME_EMAIL=dev@example.com

# --- Django (DEBUG off, like production) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=local-prod-not-secret
DJANGO_ALLOWED_HOSTS=origin,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8780
APP_BASE_URL=http://localhost:8780
# local = sign in via /api/admin. For real Cognito, see README "Local production-like stack".
AUTH_MODE=local

DATABASE_HOST=db
DATABASE_PASSWORD=lifemap-local
DATABASE_SSLMODE=disable

# S3 emulator (Moto). Media URLs are S3-presigned locally instead of CloudFront-signed.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
MEDIA_BUCKET=lifemap-media-local
AWS_S3_ENDPOINT_URL=http://s3:5000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
MEDIA_PROCESSING_ENABLED=1
INTERNAL_API_TOKEN=local-internal-token
