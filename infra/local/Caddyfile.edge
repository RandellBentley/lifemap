# Stand-in for the CloudFront distribution (infra/modules/cdn).
{
	auto_https off
	admin off
}

:8080 {
	# /api/* -> origin, adding the secret header CloudFront adds in production.
	handle /api/* {
		reverse_proxy https://origin:8443 {
			header_up Host origin
			header_up X-Origin-Verify {$ORIGIN_VERIFY_SECRET}
			transport http {
				tls_server_name origin
				tls_insecure_skip_verify # origin uses Caddy's local CA here
			}
		}
	}

	# Everything else -> the built SPA, with client-side routes falling back to index.html
	# (the CloudFront Function does this in production).
	handle {
		# Same caching as production (scripts/deploy.sh): hashed assets are immutable,
		# everything else (index.html) must be revalidated so new builds show up on reload.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry not path /assets/*
		header @entry Cache-Control "no-cache"

		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
