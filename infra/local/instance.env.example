# Copy to infra/local/instance.env (not committed) to give this checkout its own copy of the
# site. Each checkout keeps its data in its own infra/local/.data; these settings keep the
# containers, images and ports apart so copies can run at the same time.

# --- Personal copy: the one you use day to day (a separate checkout of main) ---
LIFEMAP_INSTANCE=personal
EDGE_PORT=8780
S3_PORT=9100
ORIGIN_PORT=8443
# Where backup and update save backups: another disk, outside the repository.
LIFEMAP_BACKUP_DIR="/Volumes/YOUR-DRIVE/LifeMapBackups/personal"

# --- Development copy: where changes are built and tested ---
# LIFEMAP_INSTANCE=dev
# EDGE_PORT=8790
# S3_PORT=9110
# ORIGIN_PORT=8453
# LIFEMAP_BACKUP_DIR="$HOME/LifeMapBackups/dev"
