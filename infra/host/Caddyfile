{
	email {$ACME_EMAIL}
	# Unprivileged listener; the host maps 443 -> 8443. Only that port is reachable
	# (and only from CloudFront), so skip the :80 redirect listener.
	https_port 8443
	auto_https disable_redirects
}

# Production: Let's Encrypt via Route 53. Local runs set CADDY_TLS=tls_internal (self-signed).
(tls_route53) {
	tls {
		dns route53
	}
}

(tls_internal) {
	tls internal
}

{$ORIGIN_DOMAIN} {
	import {$CADDY_TLS:tls_route53}

	# Only CloudFront knows this header, so requests that bypass it are refused.
	@cloudfront header X-Origin-Verify {$ORIGIN_VERIFY_SECRET}
	handle @cloudfront {
		reverse_proxy web:8000
	}
	handle {
		respond "Forbidden" 403
	}
}
